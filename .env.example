# Database — Neon (https://neon.tech) recommended for the HTTP driver
DATABASE_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# NextAuth — generate via: openssl rand -base64 32
AUTH_SECRET=""
# Optional in dev; required in prod:
# AUTH_URL="https://your-domain.com"

# GitHub OAuth app
# Create at: https://github.com/settings/developers → New OAuth App
# Authorization callback URL (dev): http://localhost:3000/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# AI providers — Google Gemini is primary (text + screenshot vision).
# Groq, then OpenAI, are automatic fallbacks; a provider with no key is skipped.
# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: model for screenshot analysis (defaults to GEMINI_MODEL).
# GEMINI_VISION_MODEL=
# Groq model (llama-3.3-70b-versatile was retired).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=""
OPENAI_API_KEY=""

# Which provider is tried first: "gemini", "groq" or "openai".
# The others are used as automatic fallbacks (gemini -> groq -> openai).
DEFAULT_AI_PROVIDER=gemini

# Exposed to the client so the dashboard's provider dropdown can default sensibly.
NEXT_PUBLIC_DEFAULT_AI_PROVIDER=gemini

# Resend (https://resend.com) for invite emails. Optional — if unset, the
# server logs the invite link and the UI shows a copy-link fallback.
RESEND_API_KEY=""
# Verified sending identity. Default to resend.dev test domain when unset.
RESEND_FROM="Project MARINA <onboarding@resend.dev>"

# Public base URL used in invite links. Required in prod, optional in dev
# (falls back to the request's origin).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Bumping this rolls user consent — the Mac agent will refuse to start until
# the user accepts the new policy version. Default v1.
MARINA_POLICY_VERSION="v1"

# Cron protection — Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
# Set on Vercel + here. Manual triggers can also pass `?secret=<CRON_SECRET>`.
CRON_SECRET=""

# Blob storage for screenshots. "local" writes to .marina-storage/ (dev default).
# Set to "vercel_blob" in production and supply BLOB_READ_WRITE_TOKEN.
BLOB_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""
LOCAL_BLOB_ROOT=".marina-storage"

# Structured log threshold: debug | info | warn | error
LOG_LEVEL="info"

# GitHub App (reliable org repo tracking — see GITHUB_APP_SETUP.md)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=

# Desktop agent installers shown on /download
NEXT_PUBLIC_MAC_DOWNLOAD_URL=
NEXT_PUBLIC_WIN_DOWNLOAD_URL=

# Gates /api/health diagnostics (ai/auth/env); anonymous callers get {ok, db}.
HEALTH_PROBE_SECRET=
